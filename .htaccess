Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # =========================================================
    # A. LIMPIEZA VISUAL (Lo que el usuario ve en el navegador)
    # =========================================================

    # 1. Si entran escribiendo explícitamente /public/, se lo borramos de la URL
    RewriteCond %{THE_REQUEST} \s/+(.*?/)?public/([^\s?]*) [NC]
    RewriteRule ^ /%1%2 [R=301,L,NE]

    # 2. Si escriben index.php explícitamente, lo limpiamos de la URL
    RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # =========================================================
    # B. ENRUTAMIENTO INTERNO (Oculto en el servidor)
    # =========================================================

    # 3. FRENO: Si ya estamos procesando algo dentro de public/, frenamos acá (Evita bucles)
    RewriteRule ^public/ - [L]

    # 4. Tu regla personalizada para los Slugs de los artículos
    RewriteRule ^articulo/([0-9]+)-.*$ public/articulo.php?id=$1 [L,QSA,NC]

    # 5. Si la URL está vacía (raíz del sitio), procesar discretamente public/index.php
    RewriteRule ^$ public/index.php [L]

    # 6. Todo lo demás que NO sea un archivo o carpeta real, buscalo adentro de public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>