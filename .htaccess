Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. FRENO: Si el archivo ya existe (ej: fotos, css, o el mismo index.php), no redirigir.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. REGLA A PRUEBA DE BALAS PARA EL SLUG
    # Atrapa "articulo/ID" O "public/articulo/ID" y lo manda internamente al PHP.
    RewriteRule ^(?:public/)?articulo/([0-9]+)-.*$ public/articulo.php?id=$1 [L,QSA,NC]

    # 3. REDIRECCIÓN GENERAL AL PUBLIC
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>