Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # =========================================================
    # A. LIMPIEZA VISUAL (Lo que cambia en la barra del navegador)
    # =========================================================

    # 1. Si el usuario pide /index.php o /public/index.php, lo mandamos a la raíz "/"
    RewriteCond %{THE_REQUEST} \s/+((public/)?index\.php)[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # 2. ¡NUEVO! Si el usuario entra explícitamente a /public/algo, le borramos el "/public/"
    RewriteCond %{THE_REQUEST} \s/+public/(\S*) [NC]
    RewriteRule ^ /%1 [R=301,L]

    # =========================================================
    # B. ENRUTAMIENTO INTERNO (Lo que pasa oculto en el servidor)
    # =========================================================

    # 3. FRENO: Si el servidor ya enrutó esto a public/ internamente, frenamos acá (Evita bucles)
    RewriteRule ^public/ - [L]

    # 4. Regla para Slugs de los artículos (Ya no hace falta atajar el public/ acá)
    RewriteRule ^articulo/([0-9]+)-.*$ public/articulo.php?id=$1 [L,QSA,NC]

    # 5. Inicio (Si la URL está vacía)
    RewriteRule ^$ public/index.php [L]

    # 6. Todo lo demás que no sea un archivo físico, mandalo a public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>